# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# Postgres connection string (Neon: use the *pooled* connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session cookies (HS256). Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Password given to the seeded demo accounts (admin / manager / viewer).
# Only read by `npm run db:seed`; it is never stored in plain text.
SEED_DEMO_PASSWORD="replace-with-a-demo-password"
